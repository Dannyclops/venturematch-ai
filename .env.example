# Backend
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# To enable the paid HTTP endpoint, set VENTUREMATCH_ENABLE_LIVE_AGENT=1 in the
# launching shell. Putting a key in this file alone never enables live HTTP calls.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

